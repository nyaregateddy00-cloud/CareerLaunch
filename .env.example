# CareerLaunch Environment Variables
# Copy this file to .env and fill in your values

# =============================================================
# Supabase Configuration (required for production auth + data)
# Get these from: https://app.supabase.com/project/_/settings/api
# =============================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
# =============================================================
# AI Integration (optional - for CareerLaunch AI Assistant)
# =============================================================
# Configure these server-only variables in Vercel (and in a local .env file
# only for a trusted local deployment). Use an OpenAI-compatible chat endpoint.
# Never add VITE_ to any provider secret.
CAREER_AI_API_URL=https://your-provider.example/v1/chat/completions
CAREER_AI_API_KEY=your-server-side-provider-key
CAREER_AI_MODEL=your-provider-model-id
# The existing Gemini provider is supported as a fallback when the generic
# OpenAI-compatible endpoint above is not configured.
GEMINI_API_KEY=your-server-side-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# =============================================================
# App Configuration (optional)
# =============================================================
VITE_APP_NAME=CareerLaunch
VITE_APP_URL=http://localhost:5173

# =============================================================
# Email provider (not currently enabled by the application)
# =============================================================
# VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
# VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
# VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

