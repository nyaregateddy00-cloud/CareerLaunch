# CareerLaunch Environment Variables
# Copy this file to .env and fill in your values

# =============================================================
# Supabase Configuration (required for production auth + data)
# Get these from: Supabase Dashboard > Project Settings > API
# =============================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
# Older projects may provide only the legacy anon key. Uncomment this only if
# VITE_SUPABASE_PUBLISHABLE_KEY is left empty.
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
# =============================================================
# AI Integration (optional - for CareerLaunch AI Assistant)
# =============================================================
# Configure these server-only variables in Vercel (and in a local .env file
# only for a trusted local deployment). Use an OpenAI-compatible chat endpoint.
# Never add VITE_ to any provider secret.
CAREER_AI_API_URL=https://your-provider.example/v1/chat/completions
CAREER_AI_API_KEY=your-server-side-provider-key
CAREER_AI_MODEL=your-provider-model-id
# The existing Gemini provider is supported as a fallback when the generic
# OpenAI-compatible endpoint above is not configured.
GEMINI_API_KEY=your-server-side-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# =============================================================
# Opportunity Intelligence ingestion (server-only; Vercel/API)
# =============================================================
# Never prefix these variables with VITE_. The service-role key must remain server-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key
# Set CRON_SECRET in Vercel for the scheduled GET request. For manual POST requests,
# use OPPORTUNITY_SYNC_SECRET (or set both to the same value).
CRON_SECRET=your-long-random-sync-secret
OPPORTUNITY_SYNC_SECRET=your-long-random-sync-secret
# Leave unset or set to [] until you have a feed/API with explicit redistribution permission.
# Each configured feed must have source attribution and redistributionPermitted: true.
# Only set country when the feed's listings are documented as restricted to that country.
# OPPORTUNITY_FEEDS_JSON=[{"key":"partner-feed","name":"Partner feed","url":"https://partner.example/feed.xml","country":"Kenya","attribution":"Partner name","redistributionPermitted":true,"enabled":true}]
# Optional; zero by default. When enabled, limits AI enrichment per run (maximum 5).
# AI-derived fields are marked separately from staff verification.
OPPORTUNITY_AI_ENRICH_LIMIT=0

# =============================================================
# App Configuration (optional)
# =============================================================
VITE_APP_NAME=CareerLaunch
VITE_APP_URL=http://localhost:5173

# =============================================================
# Email provider (not currently enabled by the application)
# =============================================================
# VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
# VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
# VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

